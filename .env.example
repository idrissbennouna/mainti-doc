# Copier vers .env en local. Ne jamais committer de vraies clés.
MANTIDOC_ENVIRONMENT=development
MANTIDOC_API_HOST=127.0.0.1
MANTIDOC_API_PORT=8000
MANTIDOC_LOG_LEVEL=INFO

# Jetons de démonstration uniquement (utilisateurs fictifs).
# Format : identifiant_utilisateur:jeton, séparés par des virgules.
MANTIDOC_DEMO_TOKENS=tech-pompe:demo-token-alice,tech-ventilateur:demo-token-bob,resp-maintenance:demo-token-chef
